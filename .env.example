# ---------- Verilənlər bazası ----------
DATABASE_URL=postgres://sc:scdev@localhost:5436/specialcrafts

# ---------- Sayt ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Admin ----------
# İlk admini yaratmaq üçün: npm run admin:create
SESSION_SECRET=buranı-uzun-təsadüfi-sətirlə-əvəz-edin

# ---------- Ödəniş ----------
# test  → heç bir bank çağırılmır, ödəniş simulyasiya olunur (indiki rejim)
# canli → real provayder çağırılır
PAYMENT_MODE=test

# Payriff — https://payriff.com merchant kabinetindən
PAYRIFF_MERCHANT=
PAYRIFF_SECRET=
PAYRIFF_BASE_URL=https://api.payriff.com/api/v2

# Kapital Bank e-commerce — mTLS sertifikatı bankdan verilir
# Sertifikat və açar PEM formatında, sətir sonları \n ilə
KAPITAL_MERCHANT=
KAPITAL_CERT=
KAPITAL_KEY=
KAPITAL_BASE_URL=https://tstpg.kapitalbank.az
